{
    "name": "enthusiast/integration-render-engine",
    "description": "Render integration templates with {{lead.*}} and {{static.*}} placeholders",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Enthusiast\\IntegrationRenderEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Enthusiast\\IntegrationRenderEngine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
